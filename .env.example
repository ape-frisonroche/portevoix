# Configuration de production de Porte-Voix.
# Copier en .env sur le serveur, remplir, puis : chmod 600 .env
# En dev, pas besoin de .env (valeurs par défaut : debug, emails dans le terminal).

DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=portevoix.alwaysdata.net
SITE_URL=https://portevoix.alwaysdata.net
DB_PATH=/home/<compte>/portevoix/db.sqlite3

# Emails : Gmail (voir README, section Emails ; pour Brevo : smtp-relay.brevo.com)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=ape.exemple@gmail.com
# mot de passe d'application Google, pas le mot de passe du compte
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Porte-Voix <ape.exemple@gmail.com>"

# Lien vers le PDF du kit du parent délégué
KIT_URL=
# Email de contact RGPD affiché sur le formulaire
CONTACT_RGPD=ape.exemple@gmail.com
